# Interactive Brokers Configuration
IBKR_ACCOUNT_ID=YOUR_ACCOUNT_ID
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# Trading Parameters
START_CAPITAL=5000
MAX_POSITION_SIZE=0.1  # 10% av kapitalen per trade
RISK_PER_TRADE=0.02   # 2% risiko per trade

# Strategy Parameters
STOCK_SYMBOLS=AAPL,MSFT,TSLA  # Eksempler
BACKTEST_START_DATE=2023-01-01
BACKTEST_END_DATE=2024-01-01
STOP_LOSS_PCT=0.05

# Commission (IBKR)
IBKR_COMMISSION_PERCENT=0.004
IBKR_COMMISSION_MINIMUM=1.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/trading_bot.log

# Daily Signal Bot
DISCORD_WEBHOOK_URL=
DAILY_SIGNAL_LOOKBACK_DAYS=180
MONTHLY_REBALANCE_DAY=1
DAILY_BOT_STATE_FILE=.state/daily_signal_bot_state.json
